# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Match gofmt: tabs for indentation, displayed 4 columns wide.
[{*.go,go.mod,go.sum,go.work}]
indent_style = tab
indent_size = 4

# Recipes must be indented with tabs.
[{Makefile,*.mk}]
indent_style = tab
indent_size = 4

# Trailing double spaces are intentional Markdown line breaks.
[*.md]
trim_trailing_whitespace = false

[*.{json,yaml,yml}]
indent_size = 2

# Templates and golden files must stay byte-exact; never let editors rewrite them.
[*.{tmpl,golden}]
trim_trailing_whitespace = false
insert_final_newline = unset
