# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Match gofmt.
[{*.go,go.mod,go.work}]
indent_style = tab

# Trailing double spaces are intentional Markdown line breaks.
[*.md]
trim_trailing_whitespace = false

[*.{json,yaml,yml}]
indent_size = 2
